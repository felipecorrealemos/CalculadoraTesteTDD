        resultadoMultiplicacao = calculadora.Multiplicar(10, 5);

        // TODO: Implemente o teste da multiplicação.

        // ==================================
        // TESTE 4 - DIVISÃO
        // ==================================

        int esperadoDivisao = 50;

        resultadoDivisao = calculadora.Dividir(100, 2);

        // TODO: Implemente o teste da divisão.
    }

    public void LimparResultados()
    {
        resultadoSoma = null;
        resultadoSubtracao = null;
        resultadoMultiplicacao = null;
        resultadoDivisao = null;

        testeSoma = "Teste não implementado";
        testeSubtracao = "Teste não implementado";
        testeMultiplicacao = "Teste não implementado";
        testeDivisao = "Teste não implementado";

        classeSoma = "alert-secondary";
        classeSubtracao = "alert-secondary";
        classeMultiplicacao = "alert-secondary";
        classeDivisao = "alert-secondary";
    }

    string ExibirResultado(int? resultado)
    {
        if (resultado.HasValue)
        {
            return resultado.Value.ToString();
        }

        return "—";
    }
}
